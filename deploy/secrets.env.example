# Copy to deploy/secrets.env on the box, fill real values, then: chmod 600 deploy/secrets.env
# This file is NEVER committed.

# Image tag the box runs. The deploy script updates this to each release tag.
IMAGE_TAG=latest

# GHCR image path (owner/repo lowercased).
IMAGE_REPO=ghcr.io/your-org/net_alpha

# Your Cloudflare-managed deployment domain (the Access-protected hostname).
NETALPHA_PUBLIC_HOST=net-alpha.example.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
TUNNEL_TOKEN=eyJ...

# Passphrase used to AES-256-GCM encrypt the daily backup bundles.
NETALPHA_BACKUP_PASSPHRASE=change-me-to-a-long-random-string
